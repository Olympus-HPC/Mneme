__attribute__((global)) void make_flag(
  flag_type *__restrict__ flags,
        int *__restrict__ bounce_val,
  flag_type *__restrict__ dir,
  BoxCU domain,
  outer_wall wall_type,
  int width, int height, int depth,
  int iter)
{
  int nx = domain.nx;
  int ny = domain.ny;
  int nz = domain.nz;

  for (int z = blockIdx.z; z < nz; z += gridDim.z) {
    for (int y = threadIdx.y + blockIdx.y*blockDim.y; y < ny; y += blockDim.y*gridDim.y) {
      for (int x = threadIdx.x + blockIdx.x*blockDim.x; x < nx; x += blockDim.x*gridDim.x) {

        if (x + domain.x0 == 0 ) {
          if (wall_type.xmin >= zou_he) { dir[((x + (nx))%(nx) + ((y + (ny))%(ny) + ((z + (nz))%(nz))*(ny))*(nx))] = dir::x; } if (C_p[flags[((x + (nx))%(nx) + ((y + (ny))%(ny) + ((z + (nz))%(nz))*(ny))*(nx))]] < C_p[wall_type.xmin]) { flags[((x + (nx))%(nx) + ((y + (ny))%(ny) + ((z + (nz))%(nz))*(ny))*(nx))] = wall_type.xmin; if(wall_type.xmin == type_b::bounce)bounce_val[((x + (nx))%(nx) + ((y + (ny))%(ny) + ((z + (nz))%(nz))*(ny))*(nx))] = type_b::bounce; } else if ( (wall_type.xmin == zou_he || flags[((x + (nx))%(nx) + ((y + (ny))%(ny) + ((z + (nz))%(nz))*(ny))*(nx))] == zou_he || wall_type.xmin == zou_he_p || flags[((x + (nx))%(nx) + ((y + (ny))%(ny) + ((z + (nz))%(nz))*(ny))*(nx))] == zou_he_p)&&flags[((x + (nx))%(nx) + ((y + (ny))%(ny) + ((z + (nz))%(nz))*(ny))*(nx))] != bounce) { flags[((x + (nx))%(nx) + ((y + (ny))%(ny) + ((z + (nz))%(nz))*(ny))*(nx))] = corner; }
        }else if (x + domain.x0 == width - 1) {
          if (wall_type.xmax >= zou_he) { dir[((x + (nx))%(nx) + ((y + (ny))%(ny) + ((z + (nz))%(nz))*(ny))*(nx))] = dir::x_; } if (C_p[flags[((x + (nx))%(nx) + ((y + (ny))%(ny) + ((z + (nz))%(nz))*(ny))*(nx))]] < C_p[wall_type.xmax]) { flags[((x + (nx))%(nx) + ((y + (ny))%(ny) + ((z + (nz))%(nz))*(ny))*(nx))] = wall_type.xmax; if(wall_type.xmax == type_b::bounce)bounce_val[((x + (nx))%(nx) + ((y + (ny))%(ny) + ((z + (nz))%(nz))*(ny))*(nx))] = type_b::bounce; } else if ( (wall_type.xmax == zou_he || flags[((x + (nx))%(nx) + ((y + (ny))%(ny) + ((z + (nz))%(nz))*(ny))*(nx))] == zou_he || wall_type.xmax == zou_he_p || flags[((x + (nx))%(nx) + ((y + (ny))%(ny) + ((z + (nz))%(nz))*(ny))*(nx))] == zou_he_p)&&flags[((x + (nx))%(nx) + ((y + (ny))%(ny) + ((z + (nz))%(nz))*(ny))*(nx))] != bounce) { flags[((x + (nx))%(nx) + ((y + (ny))%(ny) + ((z + (nz))%(nz))*(ny))*(nx))] = corner; }
        }

        if (y + domain.y0 == 0 ) {
          if (wall_type.ymin >= zou_he) { dir[((x + (nx))%(nx) + ((y + (ny))%(ny) + ((z + (nz))%(nz))*(ny))*(nx))] = dir::y; } if (C_p[flags[((x + (nx))%(nx) + ((y + (ny))%(ny) + ((z + (nz))%(nz))*(ny))*(nx))]] < C_p[wall_type.ymin]) { flags[((x + (nx))%(nx) + ((y + (ny))%(ny) + ((z + (nz))%(nz))*(ny))*(nx))] = wall_type.ymin; if(wall_type.ymin == type_b::bounce)bounce_val[((x + (nx))%(nx) + ((y + (ny))%(ny) + ((z + (nz))%(nz))*(ny))*(nx))] = type_b::bounce; } else if ( (wall_type.ymin == zou_he || flags[((x + (nx))%(nx) + ((y + (ny))%(ny) + ((z + (nz))%(nz))*(ny))*(nx))] == zou_he || wall_type.ymin == zou_he_p || flags[((x + (nx))%(nx) + ((y + (ny))%(ny) + ((z + (nz))%(nz))*(ny))*(nx))] == zou_he_p)&&flags[((x + (nx))%(nx) + ((y + (ny))%(ny) + ((z + (nz))%(nz))*(ny))*(nx))] != bounce) { flags[((x + (nx))%(nx) + ((y + (ny))%(ny) + ((z + (nz))%(nz))*(ny))*(nx))] = corner; }
        }else if (y + domain.y0 == height - 1) {
          if (wall_type.ymax >= zou_he) { dir[((x + (nx))%(nx) + ((y + (ny))%(ny) + ((z + (nz))%(nz))*(ny))*(nx))] = dir::y_; } if (C_p[flags[((x + (nx))%(nx) + ((y + (ny))%(ny) + ((z + (nz))%(nz))*(ny))*(nx))]] < C_p[wall_type.ymax]) { flags[((x + (nx))%(nx) + ((y + (ny))%(ny) + ((z + (nz))%(nz))*(ny))*(nx))] = wall_type.ymax; if(wall_type.ymax == type_b::bounce)bounce_val[((x + (nx))%(nx) + ((y + (ny))%(ny) + ((z + (nz))%(nz))*(ny))*(nx))] = type_b::bounce; } else if ( (wall_type.ymax == zou_he || flags[((x + (nx))%(nx) + ((y + (ny))%(ny) + ((z + (nz))%(nz))*(ny))*(nx))] == zou_he || wall_type.ymax == zou_he_p || flags[((x + (nx))%(nx) + ((y + (ny))%(ny) + ((z + (nz))%(nz))*(ny))*(nx))] == zou_he_p)&&flags[((x + (nx))%(nx) + ((y + (ny))%(ny) + ((z + (nz))%(nz))*(ny))*(nx))] != bounce) { flags[((x + (nx))%(nx) + ((y + (ny))%(ny) + ((z + (nz))%(nz))*(ny))*(nx))] = corner; }
        }

        if (z + domain.z0 == 0 ) {
          if (wall_type.zmin >= zou_he) { dir[((x + (nx))%(nx) + ((y + (ny))%(ny) + ((z + (nz))%(nz))*(ny))*(nx))] = dir::z; } if (C_p[flags[((x + (nx))%(nx) + ((y + (ny))%(ny) + ((z + (nz))%(nz))*(ny))*(nx))]] < C_p[wall_type.zmin]) { flags[((x + (nx))%(nx) + ((y + (ny))%(ny) + ((z + (nz))%(nz))*(ny))*(nx))] = wall_type.zmin; if(wall_type.zmin == type_b::bounce)bounce_val[((x + (nx))%(nx) + ((y + (ny))%(ny) + ((z + (nz))%(nz))*(ny))*(nx))] = type_b::bounce; } else if ( (wall_type.zmin == zou_he || flags[((x + (nx))%(nx) + ((y + (ny))%(ny) + ((z + (nz))%(nz))*(ny))*(nx))] == zou_he || wall_type.zmin == zou_he_p || flags[((x + (nx))%(nx) + ((y + (ny))%(ny) + ((z + (nz))%(nz))*(ny))*(nx))] == zou_he_p)&&flags[((x + (nx))%(nx) + ((y + (ny))%(ny) + ((z + (nz))%(nz))*(ny))*(nx))] != bounce) { flags[((x + (nx))%(nx) + ((y + (ny))%(ny) + ((z + (nz))%(nz))*(ny))*(nx))] = corner; }
        }else if (z + domain.z0 == depth - 1) {
          if (wall_type.zmax >= zou_he) { dir[((x + (nx))%(nx) + ((y + (ny))%(ny) + ((z + (nz))%(nz))*(ny))*(nx))] = dir::z_; } if (C_p[flags[((x + (nx))%(nx) + ((y + (ny))%(ny) + ((z + (nz))%(nz))*(ny))*(nx))]] < C_p[wall_type.zmax]) { flags[((x + (nx))%(nx) + ((y + (ny))%(ny) + ((z + (nz))%(nz))*(ny))*(nx))] = wall_type.zmax; if(wall_type.zmax == type_b::bounce)bounce_val[((x + (nx))%(nx) + ((y + (ny))%(ny) + ((z + (nz))%(nz))*(ny))*(nx))] = type_b::bounce; } else if ( (wall_type.zmax == zou_he || flags[((x + (nx))%(nx) + ((y + (ny))%(ny) + ((z + (nz))%(nz))*(ny))*(nx))] == zou_he || wall_type.zmax == zou_he_p || flags[((x + (nx))%(nx) + ((y + (ny))%(ny) + ((z + (nz))%(nz))*(ny))*(nx))] == zou_he_p)&&flags[((x + (nx))%(nx) + ((y + (ny))%(ny) + ((z + (nz))%(nz))*(ny))*(nx))] != bounce) { flags[((x + (nx))%(nx) + ((y + (ny))%(ny) + ((z + (nz))%(nz))*(ny))*(nx))] = corner; }
        }
      }
    }
  }
}



template<int nb_directions>
__attribute__((global)) void find_wall(
  flag_type *__restrict__ flags,
  flag_type *__restrict__ dir,
  int *__restrict__ where,
  const BoxCU domain,
  int iter)
{
  int nx = domain.nx;
  int ny = domain.ny;
  int nz = domain.nz;

  for (int z = blockIdx.z; z < nz; z += gridDim.z) {
    for (int y = threadIdx.y + blockIdx.y*blockDim.y; y < ny; y += blockDim.y*gridDim.y) {
      for (int x = threadIdx.x + blockIdx.x*blockDim.x; x < nx; x += blockDim.x*gridDim.x) {
        if (flags[((x + (nx))%(nx) + ((y + (ny))%(ny) + ((z + (nz))%(nz))*(ny))*(nx))] < bounce) {

          for (int i = 3; i < 3*nb_directions; i += 3){

            int xx = x + C_dirs[i ];
            int yy = y + C_dirs[i + 1];
            int zz = z + C_dirs[i + 2];

            if (flags[((xx + (nx))%(nx) + ((yy + (ny))%(ny) + ((zz + (nz))%(nz))*(ny))*(nx))] == moving_wall ) {
              flags[((x + (nx))%(nx) + ((y + (ny))%(ny) + ((z + (nz))%(nz))*(ny))*(nx))] = wall_m;
              dir[((x + (nx))%(nx) + ((y + (ny))%(ny) + ((z + (nz))%(nz))*(ny))*(nx))] = dir[((xx + (nx))%(nx) + ((yy + (ny))%(ny) + ((zz + (nz))%(nz))*(ny))*(nx))];
              where[((x + (nx))%(nx) + ((y + (ny))%(ny) + ((z + (nz))%(nz))*(ny))*(nx))] |= (1 << (((((i/3)) + (nb_directions)/2 - 1)%((nb_directions) - 1) + 1)));
            }
            if (flags[((xx + (nx))%(nx) + ((yy + (ny))%(ny) + ((zz + (nz))%(nz))*(ny))*(nx))] == bounce ) {
              if (flags[((x + (nx))%(nx) + ((y + (ny))%(ny) + ((z + (nz))%(nz))*(ny))*(nx))] != wall_m)flags[((x + (nx))%(nx) + ((y + (ny))%(ny) + ((z + (nz))%(nz))*(ny))*(nx))] = wall;
              where[((x + (nx))%(nx) + ((y + (ny))%(ny) + ((z + (nz))%(nz))*(ny))*(nx))] |= (1 << (((((i/3)) + (nb_directions)/2 - 1)%((nb_directions) - 1) + 1)));
            }
          }
        }
      }
    }
  }
}

__attribute__((device)) __attribute__((host))
inline void macroscopic(double *f, double* rho, u_type* u0, u_type* u1, u_type* u2)
{
  double X_M1 = f[ 1] + f[ 4] + f[ 5] + f[ 6] + f[ 7];
  double X_P1 = f[10] + f[13] + f[14] + f[15] + f[16];
  double X_0 = f[ 0] + f[ 2] + f[ 3] + f[ 8] + f[ 9] + f[11] + f[12] + f[17] + f[18];
  double Y_M1 = f[ 2] + f[ 4] + f[ 8] + f[ 9] + f[14];
  double Y_P1 = f[ 5] + f[11] + f[13] + f[17] + f[18];
  double Z_M1 = f[ 3] + f[ 6] + f[ 8] + f[16] + f[18];
  double Z_P1 = f[ 7] + f[ 9] + f[12] + f[15] + f[17];
  *rho = X_M1 + X_P1 + X_0;
  double one_over_rho = 1./ *rho;
  *u0 = (X_P1 - X_M1)* one_over_rho;
  *u1 = (Y_P1 - Y_M1)* one_over_rho;
  *u2 = (Z_P1 - Z_M1)* one_over_rho;
}



__attribute__((device))
inline void d_equilibrium(double* fin, double rho, const float u0, const float u1, const float u2)
{
  double usqr = 3*(u0*u0 + u1*u1 + u2*u2)/2.;
  double cu;
  rho /= 36;
  fin[0 ] = rho*(12)*(1 + (0) + ((0)*(0))/2. - (usqr));
  fin[1 ] = rho*(2)*(1 + (3*( - u0 )) + ((3*( - u0 ))*(3*( - u0 )))/2. - (usqr));
  fin[10] = fin[1] - rho *12*(-u0);
  fin[2 ] = rho*(2)*(1 + (3*( - u1 )) + ((3*( - u1 ))*(3*( - u1 )))/2. - (usqr));
  fin[11] = fin[2] - rho*12*(-u1);
  fin[3 ] = rho*(2)*(1 + (3*( - u2)) + ((3*( - u2))*(3*( - u2)))/2. - (usqr));
  fin[12] = fin[3] - rho*12*(-u2);
  cu = 3 * (-u0 - u1);
  fin[4 ] = rho*(1)*(1 + (cu) + ((cu)*(cu))/2. - (usqr));
  fin[13] = fin[4] - rho*2*cu;
  cu = 3 * (-u0 + u1);
  fin[5 ] = rho*(1)*(1 + (cu) + ((cu)*(cu))/2. - (usqr));
  fin[14] = fin[5] - rho*2*cu;
  cu = 3 * (-u0 - u2);
  fin[6 ] = rho*(1)*(1 + (cu) + ((cu)*(cu))/2. - (usqr));
  fin[15] = fin[6] - rho*2*cu;
  cu = 3*(-u0 + u2);
  fin[7 ] = rho*(1)*(1 + (cu) + ((cu)*(cu))/2. - (usqr));
  fin[16] = fin[7] - rho*2*cu;
  cu = 3*(-u1 - u2);
  fin[8 ] = rho*(1)*(1 + (cu) + ((cu)*(cu))/2. - (usqr));
  fin[17] = fin[8] - rho*2*cu;
  cu = 3*(-u1 + u2);
  fin[9 ] = rho*(1)*(1 + (cu) + ((cu)*(cu))/2. - (usqr));
  fin[18] = fin[9] - rho*2*cu;
}

template<lattice_type nb_directions>
__attribute__((global)) void init_velocity_g(
  lbm_vars d_vars,
  BoxCU domain,
  BoxCU domain_vel,
  double depth,
  float u0 , float u1, float u2,
  double rho)
{
  int nx = domain.nx;
  int ny = domain.ny;
  int nz = domain.nz;

  double finl[nb_directions];

  for (int z = blockIdx.z; z < nz; z += gridDim.z) {
    for (int y = threadIdx.y + blockIdx.y*blockDim.y; y < ny; y += blockDim.y*gridDim.y) {
      for (int x = threadIdx.x + blockIdx.x*blockDim.x; x < nx; x += blockDim.x*gridDim.x) {

        int ugi = ((x - domain_vel.x0 + domain.x0 + (domain_vel.nx))%(domain_vel.nx) + ((y - domain_vel.y0 + domain.y0 + (domain_vel.ny))%(domain_vel.ny) + ((z - domain_vel.z0 + domain.z0 + (domain_vel.nz))%(domain_vel.nz))*(domain_vel.ny))*(domain_vel.nx));




        d_vars.r[ugi] = rho;

        d_vars.u_star.u0[ugi] = u0;
        d_vars.u_star.u1[ugi] = u1;
        d_vars.u_star.u2[ugi] = u2;

        d_equilibrium(finl, rho, u0, u1, u2);

        for (int i = 0; i < nb_directions; ++i) {
          d_vars.f0[((x + (nx))%(nx) + ((y + (ny))%(ny) + ((z + (nz))%(nz))*(ny))*(nx)) + (i)*(nx)*(ny)*(nz)] = finl[i];
          d_vars.f1[((x + (nx))%(nx) + ((y + (ny))%(ny) + ((z + (nz))%(nz))*(ny))*(nx)) + (i)*(nx)*(ny)*(nz)] = finl[i];
        }
      }
    }
  }
}

__attribute__((device))
inline void streaming(
  lbm_vars d_vars,
  double *fin,
  const int x, const int y, const int z,
 const int nx, const int ny, const int nz)
{
  fin[0 ] = d_vars.f0[((x + (nx))%(nx) + ((y + (ny))%(ny) + ((z + (nz))%(nz))*(ny))*(nx)) + (0)*(nx)*(ny)*(nz)];
  fin[1 ] = d_vars.f0[((x +1 + (nx))%(nx) + ((y + (ny))%(ny) + ((z + (nz))%(nz))*(ny))*(nx)) + (1)*(nx)*(ny)*(nz)];
  fin[2 ] = d_vars.f0[((x + (nx))%(nx) + ((y +1 + (ny))%(ny) + ((z + (nz))%(nz))*(ny))*(nx)) + (2)*(nx)*(ny)*(nz)];
  fin[3 ] = d_vars.f0[((x + (nx))%(nx) + ((y + (ny))%(ny) + ((z +1 + (nz))%(nz))*(ny))*(nx)) + (3)*(nx)*(ny)*(nz)];
  fin[4 ] = d_vars.f0[((x +1 + (nx))%(nx) + ((y +1 + (ny))%(ny) + ((z + (nz))%(nz))*(ny))*(nx)) + (4)*(nx)*(ny)*(nz)];
  fin[5 ] = d_vars.f0[((x +1 + (nx))%(nx) + ((y -1 + (ny))%(ny) + ((z + (nz))%(nz))*(ny))*(nx)) + (5)*(nx)*(ny)*(nz)];
  fin[6 ] = d_vars.f0[((x +1 + (nx))%(nx) + ((y + (ny))%(ny) + ((z +1 + (nz))%(nz))*(ny))*(nx)) + (6)*(nx)*(ny)*(nz)];
  fin[7 ] = d_vars.f0[((x +1 + (nx))%(nx) + ((y + (ny))%(ny) + ((z -1 + (nz))%(nz))*(ny))*(nx)) + (7)*(nx)*(ny)*(nz)];
  fin[8 ] = d_vars.f0[((x + (nx))%(nx) + ((y +1 + (ny))%(ny) + ((z +1 + (nz))%(nz))*(ny))*(nx)) + (8)*(nx)*(ny)*(nz)];
  fin[9 ] = d_vars.f0[((x + (nx))%(nx) + ((y +1 + (ny))%(ny) + ((z -1 + (nz))%(nz))*(ny))*(nx)) + (9)*(nx)*(ny)*(nz)];
  fin[10] = d_vars.f0[((x -1 + (nx))%(nx) + ((y + (ny))%(ny) + ((z + (nz))%(nz))*(ny))*(nx)) + (10)*(nx)*(ny)*(nz)];
  fin[11] = d_vars.f0[((x + (nx))%(nx) + ((y -1 + (ny))%(ny) + ((z + (nz))%(nz))*(ny))*(nx)) + (11)*(nx)*(ny)*(nz)];
  fin[12] = d_vars.f0[((x + (nx))%(nx) + ((y + (ny))%(ny) + ((z -1 + (nz))%(nz))*(ny))*(nx)) + (12)*(nx)*(ny)*(nz)];
  fin[13] = d_vars.f0[((x -1 + (nx))%(nx) + ((y -1 + (ny))%(ny) + ((z + (nz))%(nz))*(ny))*(nx)) + (13)*(nx)*(ny)*(nz)];
  fin[14] = d_vars.f0[((x -1 + (nx))%(nx) + ((y +1 + (ny))%(ny) + ((z + (nz))%(nz))*(ny))*(nx)) + (14)*(nx)*(ny)*(nz)];
  fin[15] = d_vars.f0[((x -1 + (nx))%(nx) + ((y + (ny))%(ny) + ((z -1 + (nz))%(nz))*(ny))*(nx)) + (15)*(nx)*(ny)*(nz)];
  fin[16] = d_vars.f0[((x -1 + (nx))%(nx) + ((y + (ny))%(ny) + ((z +1 + (nz))%(nz))*(ny))*(nx)) + (16)*(nx)*(ny)*(nz)];
  fin[17] = d_vars.f0[((x + (nx))%(nx) + ((y -1 + (ny))%(ny) + ((z -1 + (nz))%(nz))*(ny))*(nx)) + (17)*(nx)*(ny)*(nz)];
  fin[18] = d_vars.f0[((x + (nx))%(nx) + ((y -1 + (ny))%(ny) + ((z +1 + (nz))%(nz))*(ny))*(nx)) + (18)*(nx)*(ny)*(nz)];
}

__attribute__((device))
inline void streaming_bounce(
  lbm_vars d_vars,
  double *fin,
  const int x, const int y, const int z,
  const int nx, const int ny, const int nz,
  int where)
{
  fin[0] = d_vars.f0[((x + (nx))%(nx) + ((y + (ny))%(ny) + ((z + (nz))%(nz))*(ny))*(nx)) + (0)*(nx)*(ny)*(nz)];
  if (where & (1 << 1)) {
    fin[1] = d_vars.f0[((x + (nx))%(nx) + ((y + (ny))%(ny) + ((z + (nz))%(nz))*(ny))*(nx)) + (10)*(nx)*(ny)*(nz)];
  }

  if (where & (1 << 2)) {
    fin[2] = d_vars.f0[((x + (nx))%(nx) + ((y + (ny))%(ny) + ((z + (nz))%(nz))*(ny))*(nx)) + (11)*(nx)*(ny)*(nz)];
  }

  if (where & (1 << 3)) {
    fin[3] = d_vars.f0[((x + (nx))%(nx) + ((y + (ny))%(ny) + ((z + (nz))%(nz))*(ny))*(nx)) + (12)*(nx)*(ny)*(nz)];
  }

  if (where & (1 << 4)) {
    fin[4] = d_vars.f0[((x + (nx))%(nx) + ((y + (ny))%(ny) + ((z + (nz))%(nz))*(ny))*(nx)) + (13)*(nx)*(ny)*(nz)];
  }

  if (where & (1 << 5)) {
    fin[5] = d_vars.f0[((x + (nx))%(nx) + ((y + (ny))%(ny) + ((z + (nz))%(nz))*(ny))*(nx)) + (14)*(nx)*(ny)*(nz)];
  }

  if (where & (1 << 6)) {
    fin[6] = d_vars.f0[((x + (nx))%(nx) + ((y + (ny))%(ny) + ((z + (nz))%(nz))*(ny))*(nx)) + (15)*(nx)*(ny)*(nz)];
  }

  if (where & (1 << 7)) {
    fin[7] = d_vars.f0[((x + (nx))%(nx) + ((y + (ny))%(ny) + ((z + (nz))%(nz))*(ny))*(nx)) + (16)*(nx)*(ny)*(nz)];
  }

  if (where & (1 << 8)) {
    fin[8] = d_vars.f0[((x + (nx))%(nx) + ((y + (ny))%(ny) + ((z + (nz))%(nz))*(ny))*(nx)) + (17)*(nx)*(ny)*(nz)];
  }

  if (where & (1 << 9)) {
    fin[9] = d_vars.f0[((x + (nx))%(nx) + ((y + (ny))%(ny) + ((z + (nz))%(nz))*(ny))*(nx)) + (18)*(nx)*(ny)*(nz)];
  }

  if (where & (1 << 10)) {
    fin[10] = d_vars.f0[((x + (nx))%(nx) + ((y + (ny))%(ny) + ((z + (nz))%(nz))*(ny))*(nx)) + (1)*(nx)*(ny)*(nz)];
  }

  if (where & (1 << 11)) {
    fin[11] = d_vars.f0[((x + (nx))%(nx) + ((y + (ny))%(ny) + ((z + (nz))%(nz))*(ny))*(nx)) + (2)*(nx)*(ny)*(nz)];
  }

  if (where & (1 << 12)) {
    fin[12] = d_vars.f0[((x + (nx))%(nx) + ((y + (ny))%(ny) + ((z + (nz))%(nz))*(ny))*(nx)) + (3)*(nx)*(ny)*(nz)];
  }

  if (where & (1 << 13)) {
    fin[13] = d_vars.f0[((x + (nx))%(nx) + ((y + (ny))%(ny) + ((z + (nz))%(nz))*(ny))*(nx)) + (4)*(nx)*(ny)*(nz)];
  }

  if (where & (1 << 14)) {
    fin[14] = d_vars.f0[((x + (nx))%(nx) + ((y + (ny))%(ny) + ((z + (nz))%(nz))*(ny))*(nx)) + (5)*(nx)*(ny)*(nz)];
  }

  if (where & (1 << 15)) {
    fin[15] = d_vars.f0[((x + (nx))%(nx) + ((y + (ny))%(ny) + ((z + (nz))%(nz))*(ny))*(nx)) + (6)*(nx)*(ny)*(nz)];
  }

  if (where & (1 << 16)) {
    fin[16] = d_vars.f0[((x + (nx))%(nx) + ((y + (ny))%(ny) + ((z + (nz))%(nz))*(ny))*(nx)) + (7)*(nx)*(ny)*(nz)];
  }

  if (where & (1 << 17)) {
    fin[17] = d_vars.f0[((x + (nx))%(nx) + ((y + (ny))%(ny) + ((z + (nz))%(nz))*(ny))*(nx)) + (8)*(nx)*(ny)*(nz)];
  }

  if (where & (1 << 18)) {
    fin[18] = d_vars.f0[((x + (nx))%(nx) + ((y + (ny))%(ny) + ((z + (nz))%(nz))*(ny))*(nx)) + (9)*(nx)*(ny)*(nz)];
  }
}

__attribute__((device)) inline void streaming_wall2(
  lbm_vars d_vars,
  double *fin,
  const int x, const int y, const int z,
  const int nx, const int ny, const int nz,
  flag_type dir,
  flag_type* boundary,
  u_type u)
{
  u_type u0 = u;
  u_type u1 = 0.;
  u_type u2 = 0.;

  if ( 0 || dir == 1){
    fin[1 ] += 2*1./18*3*( - u0 );
  }
  if ( 0 || dir == 3){
    fin[2 ] += 2*1./18*3*( - u1 );
  }
  if ( 0 || dir == 5){
    fin[3 ] += 2*1./18*3*( - u2);
  }
  if ( 0 || dir == 1|| dir == 3){
    fin[4 ] += 2*1./36*3*( - u0 - u1 );
  }
  if ( 0 || dir == 1|| dir == 2){
    fin[5 ] += 2*1./36*3*( - u0 + u1 );
  }
  if ( 0 || dir == 1|| dir == 5){
    fin[6 ] += 2*1./36*3*( - u0 - u2);
  }
  if ( 0 || dir == 1|| dir == 4){
    fin[7 ] += 2*1./36*3*( - u0 + u2);
  }
  if ( 0 || dir == 3|| dir == 5){
    fin[8 ] += 2*1./36*3*( - u1 - u2);
  }
  if ( 0 || dir == 3|| dir == 4){
    fin[9 ] += 2*1./36*3*( - u1 + u2);
  }
  if ( 0 || dir == 0){
    fin[10] += 2*1./18*3*( u0 );
  }
  if ( 0 || dir == 2){
    fin[11] += 2*1./18*3*( + u1 );
  }
  if ( 0 || dir == 4){
    fin[12] += 2*1./18*3*( + u2);
  }
  if ( 0 || dir == 0|| dir == 2){
    fin[13] += 2*1./36*3*( u0 + u1 );
  }
  if ( 0 || dir == 0|| dir == 3){
    fin[14] += 2*1./36*3*( u0 - u1 );
  }
  if ( 0 || dir == 0|| dir == 4){
    fin[15] += 2*1./36*3*( u0 + u2);
  }
  if ( 0 || dir == 0|| dir == 5){
    fin[16] += 2*1./36*3*( u0 - u2);
  }
  if ( 0 || dir == 2|| dir == 4){
    fin[17] += 2*1./36*3*( + u1 + u2);
  }
  if ( 0 || dir == 2|| dir == 5){
    fin[18] += 2*1./36*3*( + u1 - u2);
  }
}

template<lattice_type nb_directions>
__attribute__((launch_bounds(64)))
__attribute__((global)) void collide_and_stream_g(
  lbm_vars d_vars,
  const BoxCU domain,
  const double ulb,
  const double omega,
  bool out_u,
  int iter)
{
  int nx = domain.nx;
  int ny = domain.ny;
  int nz = domain.nz;

  for (int z = blockIdx.z; z < nz; z += gridDim.z) {
    for (int y = threadIdx.y + blockIdx.y*blockDim.y; y < ny; y += blockDim.y*gridDim.y) {
      for (int x = threadIdx.x + blockIdx.x*blockDim.x; x < nx; x += blockDim.x*gridDim.x) {

        double finl[nb_directions], feq[nb_directions];
        u_type u0, u1, u2;
        double rho;

        flag_type boundary = d_vars.boundary_flag[((x + (nx))%(nx) + ((y + (ny))%(ny) + ((z + (nz))%(nz))*(ny))*(nx))];

        if(boundary == bounce || boundary == moving_wall) continue;
        flag_type vel_dir = d_vars.boundary_dirs[((x + (nx))%(nx) + ((y + (ny))%(ny) + ((z + (nz))%(nz))*(ny))*(nx))];

        int ugi = ((x + (domain.nx))%(domain.nx) + ((y + (domain.ny))%(domain.ny) + ((z + (domain.nz))%(domain.nz))*(domain.ny))*(domain.nx));

        streaming(d_vars, finl, x, y, z, nx, ny, nz);

        if (boundary == wall || boundary == wall_m){
          int where = d_vars.boundary_values[((x + (nx))%(nx) + ((y + (ny))%(ny) + ((z + (nz))%(nz))*(ny))*(nx))];
          streaming_bounce(d_vars, finl, x, y, z, nx, ny, nz, where);
        }

        const u_type lid_vel = ulb;

        if (boundary == wall_m) {
          streaming_wall2(d_vars, finl, x, y, z, nx, ny, nz, vel_dir, d_vars.boundary_flag, lid_vel);
        }
        macroscopic(finl, &rho, &u0, &u1, &u2);

        if (boundary < bounce ) {

          d_equilibrium(feq, rho, u0, u1, u2);

          for (int i = 0; i < nb_directions; ++i){
            finl[i] = (1.-omega)*finl[i] +omega*feq[i];
          }
        }

        if(out_u && boundary < bounce){

          d_vars.u_star.u0[ugi] = u0;
          d_vars.u_star.u1[ugi] = u1;
          d_vars.u_star.u2[ugi] = u2;
        }

        for (int i = 0; i < nb_directions; ++i) {
          d_vars.f1[((x + (nx))%(nx) + ((y + (ny))%(ny) + ((z + (nz))%(nz))*(ny))*(nx)) + (i)*(nx)*(ny)*(nz)] = finl[i];
        }
      }
    }
  }
}
# 7 "main.cu" 2




inline void handleError(cudaError_t code, const char *file, int line)
{
  if (code != cudaSuccess) {
    fprintf(stderr, "CUDA error: %s %s %d\n", cudaGetErrorString(code), file, line);
  }
}






void u_read(lbm_vars *h_vars, lbm_vars *d_vars, int nl) {
  (handleError((cudaMemcpy(h_vars->u_star.u0, d_vars->u_star.u0, sizeof(u_type)*nl, cudaMemcpyDeviceToHost)), "main.cu", 24));
  (handleError((cudaMemcpy(h_vars->u_star.u1, d_vars->u_star.u1, sizeof(u_type)*nl, cudaMemcpyDeviceToHost)), "main.cu", 25));
  (handleError((cudaMemcpy(h_vars->u_star.u2, d_vars->u_star.u2, sizeof(u_type)*nl, cudaMemcpyDeviceToHost)), "main.cu", 26));
}

void lbm_u_alloc(lbm_u* u, size_t nl) {
  u->u0 = (u_type*)malloc(sizeof(u_type)*nl*3);
  u->u1 = u->u0 + nl;
  u->u2 = u->u1 + nl;
}

void lbm_u_gpu_alloc(lbm_u* u, size_t nl) {
  (handleError((cudaMalloc(&u->u0, sizeof(u_type)*nl*3)), "main.cu", 36));
  u->u1 = u->u0 + nl;
  u->u2 = u->u1 + nl;
  (handleError((cudaMemset(u->u0, 0, sizeof(u_type)*nl*3)), "main.cu", 39));
}

void lbm_vars_alloc(lbm_vars* vars, lattice_type nb_dir, int nl, int vnl){

  lbm_u_alloc(&vars->u, vnl);
  lbm_u_alloc(&vars->u_star, vnl);
  lbm_u_alloc(&vars->g, vnl);
  vars->f0 = (double*)malloc(nl*nb_dir*sizeof(double));
  vars->f1 = (double*)malloc(nl*nb_dir*sizeof(double));
}

void lbm_vars_gpu_alloc(lbm_vars* vars, lattice_type nb_dir, int nl, int vnl) {
  lbm_u_gpu_alloc(&vars->u_star, vnl);
  lbm_u_gpu_alloc(&vars->g, vnl);
  (handleError((cudaMalloc(&vars->f0, nl*nb_dir*sizeof(double))), "main.cu", 54));
  (handleError((cudaMalloc(&vars->f1, nl*nb_dir*sizeof(double))), "main.cu", 55));
  (handleError((cudaMalloc(&vars->boundary_flag, nl*sizeof(flag_type))), "main.cu", 56));
  (handleError((cudaMalloc(&vars->boundary_values, nl*sizeof(int))), "main.cu", 57));
  (handleError((cudaMalloc(&vars->boundary_dirs, nl*sizeof(flag_type))), "main.cu", 58));
  (handleError((cudaMalloc(&vars->r, sizeof(double)*vnl)), "main.cu", 59));
}

void init_and_allocate_data(BoxCU &domain, lbm_vars *h_vars, lbm_vars *d_vars){

  const int nl = domain.nx*domain.ny*domain.nz;
  const int vnl = nl;

  (handleError((cudaMemcpyToSymbol(C_dirs, dirs, 57*sizeof(char), 0, cudaMemcpyHostToDevice)), "main.cu", 67));
  (handleError((cudaMemcpyToSymbol(C_p, outer_bounds_priority, sizeof(outer_bounds_priority), 0, cudaMemcpyHostToDevice)), "main.cu", 68));



  lbm_vars_alloc(h_vars, D3Q19, nl, vnl);
  lbm_vars_gpu_alloc(d_vars, D3Q19, nl, vnl);

  outer_wall wall{type_b::bounce, type_b::bounce, type_b::bounce, type_b::bounce, type_b::moving_wall, type_b::bounce};


  (handleError((cudaMemset(d_vars->boundary_flag, type_b::fluid, nl*sizeof(flag_type))), "main.cu", 78));

  make_flag<<<dim3(1, domain.ny, domain.nz), domain.nx>>>( d_vars->boundary_flag, d_vars->boundary_values, d_vars->boundary_dirs, domain, wall, domain.nx, domain.ny, domain.nz, 0); (handleError((cudaPeekAtLastError()), "main.cu", 81));;


  find_wall<D3Q19><<<dim3(1, domain.ny, domain.nz), domain.nx>>>( d_vars->boundary_flag, d_vars->boundary_dirs, d_vars->boundary_values, domain, 0); (handleError((cudaPeekAtLastError()), "main.cu", 84));;

}

void deallocate_data(lbm_vars *h_vars, lbm_vars *d_vars) {
  free(h_vars->u.u0);
  free(h_vars->u_star.u0);
  free(h_vars->g.u0);
  free(h_vars->f0);
  free(h_vars->f1);
  (handleError((cudaFree(d_vars->u_star.u0)), "main.cu", 93));
  (handleError((cudaFree(d_vars->g.u0)), "main.cu", 94));
  (handleError((cudaFree(d_vars->f0)), "main.cu", 95));
  (handleError((cudaFree(d_vars->f1)), "main.cu", 96));
  (handleError((cudaFree(d_vars->boundary_flag)), "main.cu", 97));
  (handleError((cudaFree(d_vars->boundary_values)), "main.cu", 98));
  (handleError((cudaFree(d_vars->boundary_dirs)), "main.cu", 99));
  (handleError((cudaFree(d_vars->r)), "main.cu", 100));
}

double run_benchmark(BoxCU &domain, lbm_vars h_vars, lbm_vars d_vars) {

  int N = domain.ny;

  const int bench_ini_iter = 1000;
  const int bench_max_iter = 2000;
  const int output_frame = 2000;

  const double ulb = 0.02;
  const double dx = 1. / (N - 2.);
  const double dt = dx * ulb;

  const double Re = 100.;
  const double nu = ulb * (N - 2.) / Re;
  const double omega = 1. / (3. * nu + 0.5);

  printf("omega = %f\n", omega);

  const int nl = domain.nx*domain.ny*domain.nz;


  init_velocity_g<D3Q19><<<dim3(1, domain.ny, domain.nz), domain.nx >>>( d_vars, domain, domain, domain.nz, 0, 0, 0, 1.); (handleError((cudaPeekAtLastError()), "main.cu", 125));;

  int iter = 0;
  int num_bench_iter = 0;

  auto start = std::chrono::steady_clock::now();
  auto end = std::chrono::steady_clock::now();

  printf("Starting %d warmup iterations\n", bench_ini_iter);

  for(iter = 0; iter < bench_max_iter; ++iter) {

    bool do_output = iter < bench_ini_iter && iter > 0 && (iter % output_frame == 0 || iter == 149);
    if (iter == bench_ini_iter) {
      printf("Starting %d benchmark iterations\n", bench_max_iter - bench_ini_iter);
      start = std::chrono::steady_clock::now();
    }
    if (iter >= bench_ini_iter) {
      ++num_bench_iter;
    }


    collide_and_stream_g<D3Q19> <<<dim3((domain.nx-1)/64+1, domain.ny, domain.nz), 64>>>( d_vars, domain, ulb, omega, do_output, iter); (handleError((cudaPeekAtLastError()), "main.cu", 147));;



    double *tp = d_vars.f0;
    d_vars.f0 = d_vars.f1;
    d_vars.f1 = tp;
    cudaDeviceSynchronize();


    if (do_output) {
      u_read(&h_vars, &d_vars, nl);

      double energy = 0;

      for(int z = 0; z < domain.nz; ++z){
        for(int y = 0; y < domain.ny; ++y){
          for(int x = 0; x < domain.nx; ++x){
            energy += h_vars.u_star.u0[((x + (domain.nx))%(domain.nx) + ((y + (domain.ny))%(domain.ny) + ((z + (domain.nz))%(domain.nz))*(domain.ny))*(domain.nx))] *
              h_vars.u_star.u0[((x + (domain.nx))%(domain.nx) + ((y + (domain.ny))%(domain.ny) + ((z + (domain.nz))%(domain.nz))*(domain.ny))*(domain.nx))] +
              h_vars.u_star.u1[((x + (domain.nx))%(domain.nx) + ((y + (domain.ny))%(domain.ny) + ((z + (domain.nz))%(domain.nz))*(domain.ny))*(domain.nx))] *
              h_vars.u_star.u1[((x + (domain.nx))%(domain.nx) + ((y + (domain.ny))%(domain.ny) + ((z + (domain.nz))%(domain.nz))*(domain.ny))*(domain.nx))] +
              h_vars.u_star.u2[((x + (domain.nx))%(domain.nx) + ((y + (domain.ny))%(domain.ny) + ((z + (domain.nz))%(domain.nz))*(domain.ny))*(domain.nx))] *
              h_vars.u_star.u2[((x + (domain.nx))%(domain.nx) + ((y + (domain.ny))%(domain.ny) + ((z + (domain.nz))%(domain.nz))*(domain.ny))*(domain.nx))];
          }
        }
      }
      energy *= 0.5;

      printf("energy %f iteration %d \n", energy*dx*dx/(dt*dt), iter);

      if (iter == 149 && N == 102) {
        printf("Regression test at iteration %d: Average energy LU = %f", iter, energy);
        const double reference_energy = 2.09868507623;
        if (fabs(energy - reference_energy) < 1.e-7) {
          printf(": OK\n");
        }
        else {
          printf(": FAILED\nExpected the value %f\n", reference_energy);
        }
      }
    }
  }
  end = std::chrono::steady_clock::now();
  auto elapsed = std::chrono::duration_cast<std::chrono::nanoseconds>(end - start).count();
  double mlups = ((double)nl*(double)num_bench_iter / (elapsed * 1e-9f)) / 1.e6;
  return mlups;
}

int main(int argc, char* argv[]) {



  if (argc != 2) {
    printf("Usage: %s <N>\n", argv[0]);
    printf("N: domain size in each dimension\n");
    return -1;
  }
  const int N = atoi(argv[1]);

  BoxCU domain;
  domain.nx = N;
  domain.ny = N;
  domain.nz = N;
  lbm_vars h_vars, d_vars;

  init_and_allocate_data(domain, &h_vars, &d_vars);

  double mlups[10];
  for (int i = 0; i < 10; ++i)
    mlups[i] = run_benchmark(domain, h_vars, d_vars);

  deallocate_data(&h_vars, &d_vars);

  printf("\nPerformance: MLUPS\n");
  for (int i = 0; i < 10; ++i) {
    printf("%.4f\n", mlups[i]);
  }

  return 0;
}
