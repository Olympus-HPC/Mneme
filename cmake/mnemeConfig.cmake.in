@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Include the target file
include("${CMAKE_CURRENT_LIST_DIR}/mnemeTargets.cmake")
check_required_components("@PROJECT_NAME@")
set(PROJECT_VERSION @PROJECT_VERSION@)

function(add_mneme target)
  target_compile_options(${target} PUBLIC "-fpass-plugin=\$<TARGET_FILE:Mneme::regdeviceir>")
  target_link_options(${target} PUBLIC "SHELL:\$<\$<LINK_LANGUAGE:HIP>:-Xoffload-linker --load-pass-plugin=\$<TARGET_FILE:Mneme::regdeviceir>>")
endfunction()
